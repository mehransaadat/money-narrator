# Optional — defaults to a local SQLite file (money_narrator.db) if not set.
# Later, for production, this would point to a PostgreSQL database, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./money_narrator.db

# Used to sign JWT login tokens. Change this to a long random string for
# your own local .env -- generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# Free AI model router, no credit card required — get a key from
# https://openrouter.ai (Settings -> Keys -> Create Key). This is the
# same key you already used in the Next.js version of this project.
OPENROUTER_API_KEY=your-key-here

# Admin account for the admin panel. It is created (or promoted) automatically
# every time the server starts. Change the password before any real deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
